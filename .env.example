# YouTube Music Controller Configuration Example

# 🌐 Player Backend Selection
# Set to 'true' to route all playback, volume, and status queries through your 
# active, already-logged-in macOS Google Chrome browser session.
# Note: Requires enabling "Allow JavaScript from Apple Events" under View -> Developer in Chrome.
# Set to 'false' (or leave commented) to use the background 'mpv' media player.
YTM_USE_CHROME=true

# 🔐 Headless / Throttled Server Fallback Authentication
# If running in a headless server or cloud environment where OAuth setup is blocked,
# paste your raw browser 'Cookie' header string here to authenticate anonymously.
# YTM_COOKIE="your-secure-cookie-string-here"

# 🔑 Google API Custom OAuth Client Credentials (optional, only for custom OAuth token refresh)
# YTM_CLIENT_ID="your-client-id-here"
# YTM_CLIENT_SECRET="your-client-secret-here"
